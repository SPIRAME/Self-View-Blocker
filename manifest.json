{
  "manifest_version": 3,
  "name": "Buganizer Self-View Blocker",
  "version": "3.19",
  "description": "Blocks self-views and tracks 7-day view count changes on your reports.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://issuetracker.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://issuetracker.google.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "permissions": [
    "storage",
    "notifications",
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "*://issuetracker.google.com/*"
  ]
}
